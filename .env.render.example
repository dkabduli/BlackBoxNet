# Paste into Render → blackboxnet-api → Environment (Neon + demo-safe defaults).

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional; if omitted, derived from DATABASE_URL for Alembic:
# DATABASE_URL_SYNC=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

GIT_REPO_PATH=/data/config-repo
SCENARIOS_DIR=/packages/mock-scenarios
REAL_DEVICE_ENABLED=false

# Usually set automatically by render.yaml from the static site hostname:
# CORS_ORIGINS=blackboxnet-web.onrender.com

# Web service (build-time) — set in blackboxnet-web or via Blueprint:
# VITE_API_URL=blackboxnet-api.onrender.com
# VITE_SHOW_DEMO_BANNER=true
